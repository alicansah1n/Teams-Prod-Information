# --- Jira Cloud ---
# Örn: https://sirketiniz.atlassian.net  (sonunda / olmadan)
JIRA_BASE_URL=https://sirketiniz.atlassian.net
# API token'ın ait olduğu Atlassian hesabının e-postası (tercihen teknik kullanıcı)
JIRA_EMAIL=teknik.kullanici@sirket.com
# https://id.atlassian.com/manage-profile/security/api-tokens adresinden oluşturulur
JIRA_API_TOKEN=

# --- Microsoft Teams ---
# Kanal > ... > Workflows > "Post to a channel when a webhook request is received" ile oluşan URL
TEAMS_WEBHOOK_URL=

# --- Genel ---
# Tarih/saat gösterimi ve Jira releaseDate hesabı için saat dilimi
TZ_NAME=Europe/Istanbul
# Teams mesajında "Tetikleyen" olarak görünecek isim (boşsa Windows kullanıcı adı kullanılır)
TRIGGERED_BY=
